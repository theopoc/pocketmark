{
  "manifest_version": 3,
  "name": "Pocketmark",
  "version": "2.0.1",
  "description": "Save and edit Pocketmark bookmarks, with optional HTML, screenshots and PDF captures.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "debugger"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Save to Pocketmark"
  },
  "minimum_chrome_version": "120",
  "background": {
    "service_worker": "background.js"
  }
}
