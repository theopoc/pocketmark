{
  "manifest_version": 3,
  "name": "Pocketmark",
  "version": "1.0.0",
  "description": "Save a bookmark, rendered page or screenshot to your own Pocketmark server.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Save to Pocketmark"
  }
}
